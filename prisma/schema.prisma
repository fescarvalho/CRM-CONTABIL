// Schema atualizado
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Níveis de acesso globais
enum Role {
  ADMIN       // Dono/Gestor do escritório (Acesso total)
  CONTADOR    // Funcionário (Acesso apenas às empresas atribuídas)
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  nome      String
  role      Role     @default(CONTADOR)
  
  // Relação de quais empresas este usuário tem acesso explícito
  empresasAtribuidas AcessoEmpresa[]
  
  // Logs de ações tomadas pelo usuário
  logsAuditoria      LogAuditoria[]
  
  criadoEm  DateTime @default(now())
}

model Empresa {
  id           String   @id @default(uuid())
  cnpj         String   @unique
  razaoSocial  String
  status       String   @default("Ativo") // Ativo, Inativo
  
  acessos      AcessoEmpresa[]
  pastas       Pasta[]
  documentos   Documento[]
  
  criadoEm     DateTime @default(now())
}

// Tabela Pivô: Define quem acessa o quê (Multi-tenancy granular)
model AcessoEmpresa {
  id         String   @id @default(uuid())
  usuarioId  String
  empresaId  String
  
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId]) // Evita duplicidade de acesso
}

model Pasta {
  id        String   @id @default(cuid())
  nome      String
  empresaId String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?

  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parent    Pasta?  @relation("Subpastas", fields: [parentId], references: [id], onDelete: Cascade)
  subpastas Pasta[] @relation("Subpastas")

  documentos Documento[]

  @@unique([empresaId, parentId, nome, deletedAt])
  @@index([empresaId])
}

model Documento {
  id           String   @id @default(uuid())
  nome         String   
  urlStorage   String   @unique
  tamanhoBytes Int
  tipoMime     String   @default("application/pdf") 
  
  pastaId    String?  
  empresaId  String
  
  pasta      Pasta?   @relation(fields: [pastaId], references: [id], onDelete: SetNull)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  criadoEm   DateTime @default(now())
  deletedAt  DateTime?
  tags       String[] @default([])

  @@index([empresaId])
  @@index([pastaId])
}

model LogAuditoria {
  id        String   @id @default(cuid())
  usuarioId String
  acao      String   // Ex: UPLOAD, DOWNLOAD, EXCLUIR, MOVER, RESTAURAR
  detalhes  String   // Descrição extra ou JSON
  createdAt DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([createdAt])
}
